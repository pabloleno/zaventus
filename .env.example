# Ambiente local de referencia. Copie este arquivo para .env e ajuste quando necessario.
CI_ENVIRONMENT = development

app.baseURL = 'http://local.zaventus.com/'
app.indexPage = ''

database.default.hostname = localhost
database.default.database = zaventus
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi

# Gere uma chave exclusiva no .env local com: php spark key:generate
# Nunca versione a chave real usada para criptografar credenciais de pagamento.
